{
  "name": "litle-alchmimy",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "dev:perf": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "balance": "vite build --ssr tools/balance/main.ts --outDir .balance --emptyOutDir --logLevel warn && node .balance/main.js",
    "models:compress": "node scripts/compress-textures.mjs",
    "build:electron": "tsc && vite build --mode electron --base ./ --outDir dist-electron --emptyOutDir",
    "build:capacitor": "tsc && vite build --mode capacitor --outDir dist-capacitor --emptyOutDir",
    "electron:dev": "npm --prefix shells/electron run dev",
    "electron:start": "npm run build:electron && npm --prefix shells/electron run start",
    "electron:build": "npm run build:electron && npm --prefix shells/electron run dist",
    "cap:sync": "npm run build:capacitor && npm --prefix shells/capacitor run sync",
    "cap:android": "npm run cap:sync && npm --prefix shells/capacitor run android",
    "cap:ios": "npm run cap:sync && npm --prefix shells/capacitor run ios"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "i18next": "^26.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.10",
    "three": "^0.186.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
